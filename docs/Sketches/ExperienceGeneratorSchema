-- Enable required extensions
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
CREATE EXTENSION IF NOT EXISTS "pgcrypto";

-- ============================================================================
-- ENUM TYPES
-- ============================================================================

-- Organization Types
CREATE TYPE org_type_enum AS ENUM ('company', 'agency', 'venue', 'vendor', 'sponsor', 'investor');

-- Production Types
CREATE TYPE production_format_enum AS ENUM ('immersive', 'festival', 'activation', 'installation', 'theater', 'concert', 'conference', 'corporate', 'private', 'other');
CREATE TYPE production_status_enum AS ENUM ('draft', 'planning', 'pre_production', 'production', 'active', 'completed', 'cancelled', 'archived');

-- Venue & Zone Types
CREATE TYPE venue_type_enum AS ENUM ('warehouse', 'theater', 'arena', 'stadium', 'outdoor', 'convention', 'hotel', 'restaurant', 'club', 'custom', 'other');
CREATE TYPE zone_type_enum AS ENUM ('public', 'vip', 'backstage', 'production', 'operations', 'restricted', 'loading', 'parking', 'other');

-- Contact Types
CREATE TYPE contact_type_enum AS ENUM ('internal', 'vendor', 'contractor', 'sponsor', 'investor', 'media', 'artist', 'guest', 'emergency', 'other');
CREATE TYPE contact_status_enum AS ENUM ('active', 'inactive', 'pending', 'archived');

-- Department Types
CREATE TYPE department_category_enum AS ENUM ('executive', 'production', 'operations');

-- Credential Types
CREATE TYPE credential_status_enum AS ENUM ('pending', 'active', 'suspended', 'revoked', 'expired');

-- Task Types
CREATE TYPE task_status_enum AS ENUM ('not_started', 'in_progress', 'blocked', 'complete', 'cancelled');
CREATE TYPE priority_enum AS ENUM ('low', 'medium', 'high', 'critical');
CREATE TYPE deadline_type_enum AS ENUM ('hard', 'soft', 'flexible');
CREATE TYPE probability_enum AS ENUM ('low', 'medium', 'high');
CREATE TYPE impact_enum AS ENUM ('low', 'medium', 'high', 'critical');

-- Assignment Types
CREATE TYPE assignment_status_enum AS ENUM ('pending', 'confirmed', 'declined', 'completed');

-- Show & Cue Types
CREATE TYPE show_status_enum AS ENUM ('scheduled', 'confirmed', 'in_progress', 'completed', 'cancelled');
CREATE TYPE show_type_enum AS ENUM ('preview', 'regular', 'final', 'special', 'private');
CREATE TYPE cue_type_enum AS ENUM ('master', 'lighting', 'sound', 'video', 'sfx', 'scenic', 'action', 'note');
CREATE TYPE trigger_type_enum AS ENUM ('time', 'manual', 'sensor', 'previous_cue', 'conditional');

-- Contract Types
CREATE TYPE contract_category_enum AS ENUM ('partner', 'employment', 'contractor', 'subcontractor', 'vendor', 'artist', 'sponsor', 'intern', 'nda', 'other');
CREATE TYPE contract_status_enum AS ENUM ('draft', 'pending_review', 'pending_signature', 'active', 'completed', 'terminated', 'expired');

-- Permit & Insurance Types
CREATE TYPE permit_type_enum AS ENUM ('business', 'event', 'fire', 'building', 'liquor', 'food', 'music', 'noise', 'temporary_structure', 'electrical', 'pyrotechnics', 'street_closure', 'parking', 'other');
CREATE TYPE permit_status_enum AS ENUM ('not_started', 'applied', 'pending', 'approved', 'denied', 'expired');
CREATE TYPE insurance_type_enum AS ENUM ('general_liability', 'workers_comp', 'employers_liability', 'liquor_liability', 'event_cancellation', 'property', 'auto', 'umbrella', 'cyber', 'dno', 'other');
CREATE TYPE policy_status_enum AS ENUM ('pending', 'active', 'expired', 'cancelled');

-- Compliance Types
CREATE TYPE compliance_category_enum AS ENUM ('permits', 'insurance', 'safety', 'employment', 'privacy', 'other');
CREATE TYPE checklist_status_enum AS ENUM ('not_started', 'in_progress', 'complete');
CREATE TYPE item_status_enum AS ENUM ('pending', 'in_progress', 'complete', 'na');

-- Sponsor & Investor Types
CREATE TYPE sponsor_status_enum AS ENUM ('prospect', 'pitched', 'negotiating', 'confirmed', 'active', 'completed', 'declined');
CREATE TYPE investor_type_enum AS ENUM ('individual', 'institution', 'family_office', 'vc', 'angel', 'corporate', 'other');
CREATE TYPE investor_status_enum AS ENUM ('prospect', 'contacted', 'meeting', 'due_diligence', 'committed', 'funded', 'declined');
CREATE TYPE round_type_enum AS ENUM ('pre_seed', 'seed', 'series_a', 'series_b', 'bridge', 'growth', 'other');
CREATE TYPE round_status_enum AS ENUM ('planning', 'open', 'closing', 'closed');
CREATE TYPE instrument_enum AS ENUM ('equity', 'safe', 'convertible_note', 'revenue_share', 'other');
CREATE TYPE investment_status_enum AS ENUM ('committed', 'docs_sent', 'docs_signed', 'funded');

-- SOP Types
CREATE TYPE sop_status_enum AS ENUM ('draft', 'review', 'approved', 'archived');

-- Incident Types
CREATE TYPE incident_type_enum AS ENUM ('medical', 'security', 'property', 'guest_complaint', 'injury', 'theft', 'altercation', 'technical', 'weather', 'other');
CREATE TYPE severity_enum AS ENUM ('1', '2', '3', '4', '5');
CREATE TYPE incident_status_enum AS ENUM ('open', 'investigating', 'resolved', 'closed');

-- Lost & Found Types
CREATE TYPE lost_found_category_enum AS ENUM ('electronics', 'clothing', 'wallet_id', 'keys', 'jewelry', 'bag', 'glasses', 'medication', 'other');
CREATE TYPE lost_found_status_enum AS ENUM ('stored', 'claimed', 'donated', 'disposed');

-- Expense Types
CREATE TYPE expense_category_enum AS ENUM ('travel', 'meals', 'lodging', 'supplies', 'equipment', 'services', 'shipping', 'marketing', 'entertainment', 'other');
CREATE TYPE payment_method_enum AS ENUM ('personal_card', 'company_card', 'cash', 'invoice', 'check', 'wire', 'other');
CREATE TYPE expense_report_status_enum AS ENUM ('draft', 'submitted', 'approved', 'rejected', 'paid');

-- Report Types
CREATE TYPE report_status_enum AS ENUM ('draft', 'review', 'final');

-- Integration Types
CREATE TYPE integration_provider_enum AS ENUM ('slack', 'notion', 'airtable', 'monday', 'asana', 'clickup', 'google_workspace', 'microsoft_365', 'zapier', 'make', 'hubspot', 'salesforce', 'quickbooks', 'xero', 'stripe', 'square', 'eventbrite', 'tixr', 'other');
CREATE TYPE integration_status_enum AS ENUM ('pending', 'connected', 'error', 'disabled');
CREATE TYPE sync_direction_enum AS ENUM ('inbound', 'outbound', 'bidirectional');
CREATE TYPE sync_status_enum AS ENUM ('started', 'success', 'partial', 'failed');

-- Audit Types
CREATE TYPE audit_action_enum AS ENUM ('create', 'read', 'update', 'delete', 'export', 'import', 'login', 'logout', 'invite', 'approve', 'reject', 'archive', 'restore');

-- Metrics Types
CREATE TYPE granularity_enum AS ENUM ('minute', 'hour', 'day', 'week', 'month', 'quarter', 'year');


-- ============================================================================
-- CORE TABLES
-- ============================================================================

-- Organizations (Multi-tenant root)
CREATE TABLE organizations (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  name VARCHAR(255) NOT NULL,
  slug VARCHAR(100) UNIQUE NOT NULL,
  legal_name VARCHAR(255),
  type org_type_enum NOT NULL DEFAULT 'company',
  tax_id VARCHAR(50),
  website VARCHAR(255),
  logo_url VARCHAR(500),
  primary_color VARCHAR(7),
  settings JSONB DEFAULT '{}',
  metadata JSONB DEFAULT '{}',
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW(),
  deleted_at TIMESTAMPTZ
);

-- Venues
CREATE TABLE venues (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  organization_id UUID REFERENCES organizations(id) ON DELETE CASCADE,
  name VARCHAR(255) NOT NULL,
  slug VARCHAR(100),
  type venue_type_enum,
  address_line_1 VARCHAR(255),
  address_line_2 VARCHAR(255),
  city VARCHAR(100),
  state VARCHAR(50),
  postal_code VARCHAR(20),
  country VARCHAR(2) DEFAULT 'US',
  latitude DECIMAL(10,8),
  longitude DECIMAL(11,8),
  total_sqft INTEGER,
  max_capacity INTEGER,
  loading_dock BOOLEAN DEFAULT false,
  parking_spaces INTEGER,
  ada_accessible BOOLEAN DEFAULT true,
  contact_name VARCHAR(255),
  contact_phone VARCHAR(20),
  contact_email VARCHAR(255),
  amenities JSONB DEFAULT '[]',
  technical_specs JSONB,
  metadata JSONB DEFAULT '{}',
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW(),
  deleted_at TIMESTAMPTZ
);

-- Departments
CREATE TABLE departments (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  organization_id UUID REFERENCES organizations(id) ON DELETE CASCADE,
  name VARCHAR(100) NOT NULL,
  code VARCHAR(20),
  category department_category_enum,
  description TEXT,
  parent_id UUID REFERENCES departments(id),
  color VARCHAR(7),
  sort_order INTEGER DEFAULT 0,
  metadata JSONB DEFAULT '{}',
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Contacts (forward declaration for FK references)
CREATE TABLE contacts (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  organization_id UUID REFERENCES organizations(id) ON DELETE CASCADE,
  user_id UUID,
  type contact_type_enum NOT NULL DEFAULT 'internal',
  status contact_status_enum DEFAULT 'active',
  prefix VARCHAR(20),
  first_name VARCHAR(100) NOT NULL,
  last_name VARCHAR(100) NOT NULL,
  nickname VARCHAR(50),
  email VARCHAR(255),
  email_secondary VARCHAR(255),
  phone VARCHAR(20),
  phone_secondary VARCHAR(20),
  company VARCHAR(255),
  job_title VARCHAR(100),
  department_id UUID REFERENCES departments(id),
  reports_to_id UUID REFERENCES contacts(id),
  address_line_1 VARCHAR(255),
  address_line_2 VARCHAR(255),
  city VARCHAR(100),
  state VARCHAR(50),
  postal_code VARCHAR(20),
  country VARCHAR(2) DEFAULT 'US',
  timezone VARCHAR(50) DEFAULT 'America/New_York',
  avatar_url VARCHAR(500),
  emergency_contact_name VARCHAR(255),
  emergency_contact_phone VARCHAR(20),
  emergency_contact_relation VARCHAR(50),
  notes TEXT,
  tags TEXT[] DEFAULT '{}',
  metadata JSONB DEFAULT '{}',
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW(),
  deleted_at TIMESTAMPTZ
);

-- Add department head FK after contacts exists
ALTER TABLE departments ADD COLUMN head_contact_id UUID REFERENCES contacts(id);

-- Productions
CREATE TABLE productions (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  organization_id UUID NOT NULL REFERENCES organizations(id) ON DELETE CASCADE,
  title VARCHAR(255) NOT NULL,
  slug VARCHAR(100) UNIQUE,
  tagline VARCHAR(255),
  description TEXT,
  elevator_pitch TEXT,
  format production_format_enum,
  status production_status_enum DEFAULT 'draft',
  genre VARCHAR(100),
  target_transformation TEXT,
  primary_venue_id UUID REFERENCES venues(id),
  capacity_per_show INTEGER,
  shows_per_day INTEGER,
  runtime_minutes INTEGER,
  announcement_date DATE,
  on_sale_date DATE,
  preview_start DATE,
  opening_date DATE,
  closing_date DATE,
  load_in_start DATE,
  load_out_end DATE,
  production_budget DECIMAL(12,2),
  operating_budget_weekly DECIMAL(10,2),
  ticket_price_min DECIMAL(8,2),
  ticket_price_max DECIMAL(8,2),
  projected_gross DECIMAL(12,2),
  break_even_percentage DECIMAL(5,2),
  sponsorship_target DECIMAL(10,2),
  color_palette JSONB,
  sensory_design JSONB,
  xyz_foundation JSONB,
  url_irl_journey JSONB,
  metadata JSONB DEFAULT '{}',
  created_by UUID REFERENCES contacts(id),
  updated_by UUID REFERENCES contacts(id),
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW(),
  deleted_at TIMESTAMPTZ
);

-- Zones
CREATE TABLE zones (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  venue_id UUID REFERENCES venues(id) ON DELETE CASCADE,
  production_id UUID REFERENCES productions(id) ON DELETE CASCADE,
  name VARCHAR(100) NOT NULL,
  code VARCHAR(20),
  type zone_type_enum,
  description TEXT,
  sqft INTEGER,
  capacity INTEGER,
  access_level INTEGER DEFAULT 1,
  color VARCHAR(7),
  sort_order INTEGER DEFAULT 0,
  metadata JSONB DEFAULT '{}',
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);


-- ============================================================================
-- ROLES & CREDENTIALS
-- ============================================================================

-- Credential Types
CREATE TABLE credential_types (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  organization_id UUID REFERENCES organizations(id) ON DELETE CASCADE,
  name VARCHAR(100) NOT NULL,
  code VARCHAR(20) NOT NULL,
  description TEXT,
  color VARCHAR(7),
  access_level INTEGER DEFAULT 1,
  requires_photo BOOLEAN DEFAULT false,
  requires_background_check BOOLEAN DEFAULT false,
  max_per_production INTEGER,
  sort_order INTEGER DEFAULT 0,
  metadata JSONB DEFAULT '{}',
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Roles
CREATE TABLE roles (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  organization_id UUID REFERENCES organizations(id) ON DELETE CASCADE,
  department_id UUID REFERENCES departments(id),
  title VARCHAR(100) NOT NULL,
  tier INTEGER CHECK (tier BETWEEN 1 AND 4),
  description TEXT,
  responsibilities TEXT[] DEFAULT '{}',
  qualifications TEXT[] DEFAULT '{}',
  reports_to_role_id UUID REFERENCES roles(id),
  is_management BOOLEAN DEFAULT false,
  default_credential_type_id UUID REFERENCES credential_types(id),
  hourly_rate_min DECIMAL(8,2),
  hourly_rate_max DECIMAL(8,2),
  metadata JSONB DEFAULT '{}',
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Credentials
CREATE TABLE credentials (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  production_id UUID REFERENCES productions(id) ON DELETE CASCADE,
  contact_id UUID REFERENCES contacts(id) ON DELETE CASCADE,
  credential_type_id UUID REFERENCES credential_types(id),
  credential_number VARCHAR(50),
  status credential_status_enum DEFAULT 'active',
  valid_from DATE NOT NULL,
  valid_until DATE NOT NULL,
  photo_url VARCHAR(500),
  issued_by_id UUID REFERENCES contacts(id),
  issued_at TIMESTAMPTZ,
  revoked_at TIMESTAMPTZ,
  revoked_by_id UUID REFERENCES contacts(id),
  revocation_reason TEXT,
  notes TEXT,
  metadata JSONB DEFAULT '{}',
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Credential Zone Access (Junction)
CREATE TABLE credential_zone_access (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  credential_type_id UUID NOT NULL REFERENCES credential_types(id) ON DELETE CASCADE,
  zone_id UUID NOT NULL REFERENCES zones(id) ON DELETE CASCADE,
  access_allowed BOOLEAN DEFAULT true,
  time_restrictions JSONB,
  notes TEXT,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  UNIQUE(credential_type_id, zone_id)
);

-- Production Assignments
CREATE TABLE production_assignments (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  production_id UUID NOT NULL REFERENCES productions(id) ON DELETE CASCADE,
  contact_id UUID NOT NULL REFERENCES contacts(id) ON DELETE CASCADE,
  role_id UUID REFERENCES roles(id),
  department_id UUID REFERENCES departments(id),
  status assignment_status_enum DEFAULT 'confirmed',
  start_date DATE,
  end_date DATE,
  hourly_rate DECIMAL(8,2),
  contract_id UUID,
  notes TEXT,
  metadata JSONB DEFAULT '{}',
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW(),
  UNIQUE(production_id, contact_id, role_id)
);


-- ============================================================================
-- SCHEDULING
-- ============================================================================

-- Schedule Phases
CREATE TABLE schedule_phases (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  organization_id UUID REFERENCES organizations(id) ON DELETE CASCADE,
  name VARCHAR(100) NOT NULL,
  code VARCHAR(20),
  description TEXT,
  sort_order INTEGER DEFAULT 0,
  color VARCHAR(7),
  is_default BOOLEAN DEFAULT false,
  metadata JSONB DEFAULT '{}',
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Schedule Tasks
CREATE TABLE schedule_tasks (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  production_id UUID NOT NULL REFERENCES productions(id) ON DELETE CASCADE,
  phase_id UUID REFERENCES schedule_phases(id),
  parent_task_id UUID REFERENCES schedule_tasks(id),
  title VARCHAR(255) NOT NULL,
  description TEXT,
  status task_status_enum DEFAULT 'not_started',
  priority priority_enum DEFAULT 'medium',
  progress_percent INTEGER DEFAULT 0,
  -- WHO
  assignee_id UUID REFERENCES contacts(id),
  department_id UUID REFERENCES departments(id),
  approver_id UUID REFERENCES contacts(id),
  -- WHEN
  start_date DATE,
  end_date DATE,
  start_time TIME,
  end_time TIME,
  duration_hours DECIMAL(6,2),
  deadline_type deadline_type_enum DEFAULT 'soft',
  actual_start TIMESTAMPTZ,
  actual_end TIMESTAMPTZ,
  -- WHERE
  location VARCHAR(255),
  zone_id UUID REFERENCES zones(id),
  is_remote BOOLEAN DEFAULT false,
  -- WHY
  purpose TEXT,
  impact_if_delayed TEXT,
  -- HOW
  resources_required TEXT,
  budget_allocated DECIMAL(10,2),
  equipment_needed TEXT[] DEFAULT '{}',
  labor_hours DECIMAL(6,2),
  -- Dependencies
  depends_on UUID[] DEFAULT '{}',
  blocks UUID[] DEFAULT '{}',
  -- Notes
  internal_notes TEXT,
  external_notes TEXT,
  -- Meta
  tags TEXT[] DEFAULT '{}',
  metadata JSONB DEFAULT '{}',
  created_by UUID REFERENCES contacts(id),
  updated_by UUID REFERENCES contacts(id),
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW(),
  deleted_at TIMESTAMPTZ
);

-- Task Contingencies
CREATE TABLE task_contingencies (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  task_id UUID NOT NULL REFERENCES schedule_tasks(id) ON DELETE CASCADE,
  if_condition TEXT NOT NULL,
  then_action TEXT NOT NULL,
  escalation_contact_id UUID REFERENCES contacts(id),
  probability probability_enum,
  impact impact_enum,
  is_triggered BOOLEAN DEFAULT false,
  triggered_at TIMESTAMPTZ,
  resolution_notes TEXT,
  metadata JSONB DEFAULT '{}',
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);


