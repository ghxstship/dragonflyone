-- Daily Metrics View
CREATE VIEW daily_metrics AS
SELECT 
  date,
  production_id,
  SUM(attendance) as total_attendance,
  SUM(ticket_revenue) as ticket_revenue,
  SUM(fb_revenue) as fb_revenue,
  SUM(merch_revenue) as merch_revenue,
  SUM(total_revenue) as total_revenue,
  AVG(capacity_percent) as avg_capacity,
  COUNT(DISTINCT show_id) as show_count
FROM daily_reports
GROUP BY date, production_id;

-- Production Summary View
CREATE VIEW production_summary AS
SELECT
  p.id,
  p.title,
  p.status,
  p.opening_date,
  p.closing_date,
  COUNT(DISTINCT s.id) as total_shows,
  SUM(s.attendance) as total_attendance,
  COUNT(DISTINCT i.id) as total_incidents,
  COUNT(DISTINCT sp.id) as sponsor_count
FROM productions p
LEFT JOIN shows s ON s.production_id = p.id
LEFT JOIN incidents i ON i.production_id = p.id
LEFT JOIN sponsors sp ON sp.production_id = p.id AND sp.status = 'active'
WHERE p.deleted_at IS NULL
GROUP BY p.id;

-- Active Credentials View
CREATE VIEW active_credentials AS
SELECT 
  c.*,
  ct.name as credential_type_name,
  ct.code as credential_type_code,
  ct.access_level,
  co.first_name,
  co.last_name,
  co.email,
  p.title as production_title
FROM credentials c
JOIN credential_types ct ON c.credential_type_id = ct.id
JOIN contacts co ON c.contact_id = co.id
JOIN productions p ON c.production_id = p.id
WHERE c.status = 'active'
  AND c.valid_from <= CURRENT_DATE
  AND c.valid_until >= CURRENT_DATE;

-- Upcoming Tasks View
CREATE VIEW upcoming_tasks AS
SELECT 
  t.*,
  p.title as production_title,
  a.first_name as assignee_first_name,
  a.last_name as assignee_last_name,
  d.name as department_name
FROM schedule_tasks t
JOIN productions p ON t.production_id = p.id
LEFT JOIN contacts a ON t.assignee_id = a.id
LEFT JOIN departments d ON t.department_id = d.id
WHERE t.status NOT IN ('complete', 'cancelled')
  AND t.deleted_at IS NULL
  AND t.end_date >= CURRENT_DATE
ORDER BY t.end_date, t.priority DESC;


