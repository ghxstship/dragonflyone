{
  "extends": "../tsconfig/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": [
    "index.ts",
    "auth-helpers.ts",
    "supabase-client.ts",
    "supabase-types.ts",
    "rpc-client.ts",
    "analytics-client.ts",
    "realtime-client.ts",
    "validation.ts",
    "storage-client.ts",
    "logger.ts",
    "error-tracking.ts",
    "monitoring.ts",
    "api-client.ts",
    "offline-handler.ts",
    "request-interceptor.ts",
    "roles.ts",
    "workflow-helpers.ts",
    "api-helpers.ts",
    "form-validators.ts",
    "middleware.ts",
    "status-utils.ts",
    "app-context.tsx",
    "auth-context.tsx",
    "production-context.tsx",
    "auth-schemas.ts",
    "auth-actions.ts",
    "kpi-client.ts",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "middleware/**/*.ts",
    "notifications/**/*.ts",
    "webhooks/**/*.ts",
    "types/**/*.ts",
    "i18n/**/*.ts",
    "i18n/**/*.tsx",
    "stores/**/*.ts",
    "stores/**/*.tsx",
    "providers.tsx",
    "query-client.tsx",
    "query-utils.ts",
    "mfa.ts",
    "cross-app-navigation.ts",
    "api-versioning.ts",
    "sso-config.ts",
    "permissions.ts",
    "logging.ts",
    "session-config.ts",
    "rate-limiting.ts",
    "export-utils.ts",
    "import-utils.ts",
    "saved-filters.ts",
    "pdf-generator.ts",
    "catalog-categories.ts",
    "navigation-types.ts",
    "calendar-utils.ts",
    "types/**/*.ts",
    "providers/**/*.ts",
    "providers/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "vitest.config.ts",
    "layouts/**/*",
    "components/**/*"
  ]
}
