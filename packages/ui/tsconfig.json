{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "noEmit": false,
    "noEmitOnError": false,
    "types": ["node", "react", "google.maps"]
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
